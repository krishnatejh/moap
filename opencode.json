{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  // Models for all eight MOAP agents live here, in one place. This is the
  // only file a new project edits for model choice — see the tier table in
  // README.md. Agent prompts in .opencode/agents/ set behavior only.
  "agent": {
    "orchestrator": { "model": "openrouter/z-ai/glm-5.3" },
    "architect": { "model": "openrouter/z-ai/glm-5.3" },
    "reviewer": { "model": "openrouter/z-ai/glm-5.3" },
    "requirements": { "model": "opencode/muse-spark-1.3-contributor-free" },
    "ux": { "model": "opencode/muse-spark-1.3-contributor-free" },
    "ui": { "model": "opencode/muse-spark-1.3-contributor-free" },
    "coder": { "model": "opencode/muse-spark-1.3-contributor-free" },
    "tester": { "model": "opencode/muse-spark-1.3-contributor-free" }
  }
}
